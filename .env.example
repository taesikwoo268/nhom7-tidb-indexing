# Machine environment profile (M1, M2, M3)
MACHINE_ID=M2

# Resource profile (XS: default on 16 GB machines; S and M only after their smoke test)
PROFILE=XS

# Optional port overrides (defaults: TiDB=4000, MySQL=3306)
# On machines with host MySQL already running, override to 3307:
MYSQL_PORT=3307
TIDB_PORT=4000
