# Virtual environments, Python caches and local credentials
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
/.env
/.env.*
!/.env.example

# Generated input and machine-local raw artifacts
/data/*
!/data/.gitkeep
*.tsv
/results/raw/*
